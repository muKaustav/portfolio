{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/pvt/fitness(/.*)?$",
      "dest": "https://origin-fitness.kaustavmukhopadhyay.com/pvt/fitness$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-origin-auth" },
          "args": "$ORIGIN_SECRET",
          "env": ["ORIGIN_SECRET"]
        }
      ]
    },
    { "handle": "filesystem" },
    { "src": "^/api/(.*)$", "dest": "/api/$1" }
  ]
}
